<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView_customer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Cliente"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView_customer_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoLink="phone"
            tools:text="Teléfono: 123-456-7890" />

        <TextView
            android:id="@+id/textView_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Total: $0.00" />

        <TextView
            android:id="@+id/textView_order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Fecha Pedido: DD/MM/AAAA" />

        <TextView
            android:id="@+id/textView_delivery_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimaryDark"
            tools:text="Fecha Entrega: DD/MM/AAAA HH:mm" />

        <TextView
            android:id="@+id/textView_order_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Dirección: ..." />

        <TextView
            android:id="@+id/textView_order_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="italic"
            android:textColor="#5D4037"
            tools:text="Productos: ..." />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"> <!-- Altura mínima para alinear bien el ImageButton -->

            <!-- Botón para pedidos PENDIENTES -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mark_delivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Marcar como Entregado"
                android:visibility="gone"
                app:backgroundTint="#6D4C41"
                app:icon="@drawable/ic_check"
                tools:visibility="visible"/>

            <!-- Botón para pedidos ENTREGADOS -->
            <ImageButton
                android:id="@+id/button_delete_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar del historial"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="?attr/colorError"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
